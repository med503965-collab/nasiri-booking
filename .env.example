# انسخي هذا الملف إلى .env.local للتطوير المحلي، ولا تضعي القيم الحقيقية هنا أبدًا.
# في الإنتاج (Render) أضيفي هذه القيم في Render > Environment Variables فقط.

# Supabase — من إعدادات المشروع في supabase.com (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# سري جدًا — يُستخدم فقط على الخادم (سكريبت ensure-admin)، لا يظهر أبدًا في المتصفح أو Git
SUPABASE_SERVICE_ROLE_KEY=

# رقم واتساب المتجر بصيغة دولية بدون + أو مسافات، مثال: 212600000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# رابط الموقع بعد النشر، مثال: https://ayouna.onrender.com
NEXT_PUBLIC_SITE_URL=

# حساب المدير — يُستخدم مرة واحدة عند تشغيل npm run ensure-admin لإنشاء/مزامنة حساب Admin
# لا تضعي كلمة سر حقيقية هنا؛ أضيفيها فقط في Render Environment Variables
ADMIN_EMAIL=
ADMIN_PASSWORD=
